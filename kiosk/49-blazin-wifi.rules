// Allow the physical kiosk session to manage and read NetworkManager profiles.
polkit.addRule(function(action, subject) {
    if (subject.user === "board" && subject.local && subject.active &&
        (action.id === "org.freedesktop.NetworkManager.settings.modify.system" ||
         action.id === "org.freedesktop.NetworkManager.network-control" ||
         action.id === "org.freedesktop.NetworkManager.wifi.scan")) {
        return polkit.Result.YES;
    }
});

// Permit only starting the existing pricing sync from the active kiosk session.
polkit.addRule(function(action, subject) {
    if (subject.user === "board" && subject.local && subject.active &&
        action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "blazin-update.service" &&
        action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
});
